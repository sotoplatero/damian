node_modules

# Worktrees de Claude Code. Viven dentro de .claude/, que SI tiene ficheros
# trackeados (settings.local.json), asi que sin esta linea un `git add -A`
# intenta meter el arbol de trabajo entero de un worktree en un commit.
.claude/worktrees/

# Espacio de trabajo de subagent-driven-development: ledger, briefs e informes.
# Es scratch, el registro de verdad es el historial de git.
.superpowers/

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# Dev server logs written by the Codex runner. Scratch, and they grow.
.codex-dev-server.log
.codex-dev-server.err.log

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Las paginas descargadas por el banco de pruebas y sus informes. Se regeneran
# solas y son megas de HTML ajeno: el repo guarda el corpus (las URLs y su
# etiqueta), no las copias.
evals/.cache/
evals/.out/

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

.vercel

# La auditoria de referencia de /tool/newsletter NO va al repo.
# Es una auditoria critica de una publicacion real, con nombre, y este repo es
# publico: publicarla seria senalar a alguien sin que lo sepa. Se queda en local
# como diana contra la que medir el informe. Lo que si es durable -el metodo y las
# lecciones- esta en CLAUDE.md y en los comentarios de src/lib/tools/newsletter/.
docs/auditoria-de-referencia.md
