# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OpenAI API — usada por /tool/lyra y /tool/copy
OPENAI_API_KEY=your_openai_api_key_here

# --- Resend: recoge los emails y manda el correo de bienvenida ---
# La newsletter semanal (Objeto Brillante) se publica en Substack: los
# contactos se exportan de aquí y se importan allí a mano. No hay cron.
# 1) Crea la cuenta en https://resend.com y verifica tu dominio de envío
# 2) Crea una API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# La dirección "from", en tu dominio verificado
RESEND_FROM=Damian <damian@tudominio.com>
# Audiencia donde se guardan los emails: https://resend.com/audiences
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL pública del sitio, para construir los enlaces de baja (sin barra final)
PUBLIC_SITE_URL=https://tudominio.com

# Cadena larga y aleatoria: firma los enlaces de baja para que no se falsifiquen
UNSUBSCRIBE_SECRET=change_me_to_a_long_random_string
